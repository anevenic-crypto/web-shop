{
  "name": "web-shop",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check-types": "npm run check-types --workspaces --if-present",
    "dev:web": "npm run dev --workspace web --",
    "db:push": "npm run db:push --workspace @web-shop/db --",
    "db:studio": "npm run db:studio --workspace @web-shop/db --",
    "db:generate": "npm run db:generate --workspace @web-shop/db --",
    "db:migrate": "npm run db:migrate --workspace @web-shop/db --",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@web-shop/env": "*",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.2.0",
    "@web-shop/config": "*",
    "typescript": "^6.0.3"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  }
}
